# Secrets for `lk agent create --secrets-file .env.agent`
# Copy this file to `.env.agent` (gitignored) and fill values.
# Do NOT put LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET here —
# LiveKit Cloud injects those at runtime.
# Portal vars (PORTAL_PASSWORD, PORTAL_HOST) are not needed on the agent.

OPENAI_API_KEY=
AGENT_PERSONA=leo
PRACTICE_SOFTWARE=mock
LEO_REALTIME_VOICE=marin

# Same Upstash Redis as the Vercel portal so Call Ava bookings match the desk.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MOCK_DIARY_REDIS_KEY=ava-mock-diary
DIARY_STORE=redis

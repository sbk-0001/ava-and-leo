LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Persona: ava | generic
# ava = Shellharbour / Dapto / Woonona Realtime receptionist (callers hear Ava).
# generic = secondary AssemblyAI/Groq/Cartesia assistant.
# Aliases: leo → ava, ava-generic → generic.
# Unset: ava on telephony (SIP / outbound), generic on web/console.
# Local portal / run_local.py sets ava.
AGENT_PERSONA=

# Generic pipeline (AssemblyAI STT, Groq LLM, Cartesia TTS)
ASSEMBLYAI_API_KEY=
GROQ_API_KEY=
CARTESIA_API_KEY=

# Ava path (OpenAI Realtime, model gpt-realtime)
OPENAI_API_KEY=
# Separate live project / TPM pool. Must not equal the demo/harness key.
# OPENAI_LIVE_API_KEY=
# OPENAI_DEMO_API_KEY=
# OPENAI_HARNESS_API_KEY=
# Telnyx / LiveKit SIP host. Startup asserts this (or EXPECTED_SIP_HOST).
# LIVEKIT_SIP_HOST=5sft82r5337.sip.livekit.cloud
# EXPECTED_SIP_HOST=5sft82r5337.sip.livekit.cloud
# Overflow number if the 429 circuit breaker opens.
# OVERFLOW_NUMBER=
# Reminder only — OpenAI does not expose a client-side TPM override.
# Long chatty demos (10+ min) can hit Realtime tokens-per-minute and log
#   RealtimeError: response failed: [tokens] rate_limit_exceeded
# Request a higher Realtime TPM limit on the OpenAI project for those demos.
# OPENAI_REALTIME_TPM=
# OpenAI Realtime has no AU-specific voice. marin = feminine (default), cedar = masculine.
AVA_REALTIME_VOICE=marin
# Legacy alias still honoured if AVA_REALTIME_VOICE is unset.
# LEO_REALTIME_VOICE=marin

# Noise cancellation on Call Ava / SIP (agent input).
# 1 (default) = LiveKit Cloud Krisp BVC (web) / BVCTelephony (SIP) when the
#   livekit-plugins-noise-cancellation import succeeds; else empty RoomOptions
#   and a warning so Ava still publishes audio.
# 0 / off = no filter (empty RoomOptions).
# ai_coustics = QUAIL_VF_S only if AI_COUSTICS_LICENSE_KEY is set.
# Do not enable ai_coustics without a license: missing enhancer auth previously
# hung session.start with 0 published audio tracks (silent Ava).
AVA_NOISE_CANCELLATION=1
# AI_COUSTICS_LICENSE_KEY=

# Outbound SIP (lk sip outbound list)
SIP_OUTBOUND_TRUNK_ID=
# Optional caller ID / from-number for outbound
SIP_OUTBOUND_NUMBER=
# Cold transfer destination (E.164 or sip: URI). Per-branch overrides win.
SIP_TRANSFER_TO=
# SIP_TRANSFER_SHELLHARBOUR=+61242169911
# SIP_TRANSFER_DAPTO=+61242880737
# SIP_TRANSFER_WOONONA=+61242844486

# Demo kill-switch: 1/true routes the call straight to a human (transfer_to_human).
AVA_KILL_SWITCH=0

# Inbound DID → branch. Mapped at session start into CallState BEFORE Ava speaks.
# Example: +61242169911:shellharbour,+61242880737:dapto,+61242844486:woonona
SIP_DID_MAP=+61242169911:shellharbour,+61242880737:dapto,+61242844486:woonona

# Booking backend: memory (seeded week) | zavy360 (stub; fails closed)
# PRACTICE_SOFTWARE=mock still selects the in-memory diary for the portal.
BOOKING_PROVIDER=memory
# ZAVY360_API_URL=
# ZAVY360_API_KEY=
# BOOKING_FORCE_TIMEOUT=0
# BOOKING_TIMEOUT_S=8
# Optional LiveKit Cloud egress download target for
# `uv run python src/never_silent_harness.py --live`. Local WAV mix
# is always written under demos/never-silent/ even without S3.
# EGRESS_S3_BUCKET=
# EGRESS_S3_ACCESS_KEY=
# EGRESS_S3_SECRET=
# EGRESS_S3_REGION=ap-southeast-2
# EGRESS_S3_ENDPOINT=
# CALLER_TTS_MODEL=gpt-4o-mini-tts
# CALLER_TTS_VOICE=alloy

# Practice software: mock | disconnected
# Unset: mock on local/dev/portal/console; disconnected on telephony and `start`.
PRACTICE_SOFTWARE=mock
# Shared JSON diary for portal + agent when they run as two processes
MOCK_DIARY_PATH=.data/mock_diary.json

# Replayable call logs (timestamps always set)
AVA_CALL_LOG_DIR=.data/call_logs

# Clinic portal (uv run python src/run_local.py → http://127.0.0.1:8787)
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8787
# Shared gate. Leave empty for localhost demo; set before exposing the portal.
PORTAL_PASSWORD=
# Worker → desk HTTP bus (web Call Ava + inbound SIP). For a local tunnel desk,
# point this at the portal process, not the public hostname:
#   DESK_EVENTS_URL=http://127.0.0.1:8787
# PORTAL_URL is an alias (run_local.py sets both).
# DESK_EVENTS_URL=http://127.0.0.1:8787
# PORTAL_URL=http://127.0.0.1:8787
# Optional shared secret for POST /api/desk/events when the worker is not loopback.
# DESK_EVENTS_TOKEN=
# SSE /api/desk/stream accepts the portal cookie or ?token= (cookie digest or PORTAL_PASSWORD).

# Optional call logging
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Persona: ava | leo
# Unset: leo on telephony (SIP / outbound), ava on web/console.
# Local portal / run_local.py sets leo.
AGENT_PERSONA=

# Ava pipeline (AssemblyAI STT, Groq LLM, Cartesia TTS)
ASSEMBLYAI_API_KEY=
GROQ_API_KEY=
CARTESIA_API_KEY=

# Leo path (OpenAI Realtime, model gpt-realtime)
OPENAI_API_KEY=
# OpenAI Realtime has no AU-specific voice. marin = feminine (default), cedar = masculine.
LEO_REALTIME_VOICE=marin

# Outbound SIP (lk sip outbound list)
SIP_OUTBOUND_TRUNK_ID=
# Optional caller ID / from-number for outbound
SIP_OUTBOUND_NUMBER=
# Cold transfer destination (E.164 or sip: URI)
SIP_TRANSFER_TO=

# Inbound DID → branch. Comma-separated did:branch_id
# Example: +61242169911:shellharbour,+61242880737:dapto,+61242844486:woonona
SIP_DID_MAP=

# Practice software: mock | disconnected
# Unset: mock on local/dev/portal/console; disconnected on telephony and `start`.
PRACTICE_SOFTWARE=mock
# Shared JSON diary for portal + agent when they run as two local processes.
# On Vercel / LiveKit Cloud this file is ephemeral — use Redis or Supabase instead.
MOCK_DIARY_PATH=.data/mock_diary.json

# Durable mock diary for two users (Vercel portal + LiveKit Cloud agent).
# Auto: Upstash Redis if URL+token are set; else file locally; in-memory on Vercel
# without Redis (not shared). Explicit: memory | file | redis | supabase
DIARY_STORE=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MOCK_DIARY_REDIS_KEY=ava-mock-diary
# Optional instead of Redis: run supabase/mock_diary.sql, then:
MOCK_DIARY_TABLE=
MOCK_DIARY_ROW_ID=shared

# Clinic portal (uv run python src/run_local.py → http://127.0.0.1:8787)
# Vercel: LIVEKIT_*, PORTAL_PASSWORD, PRACTICE_SOFTWARE=mock, plus Redis or Supabase.
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8787
# Shared gate. Leave empty for localhost demo; required on Vercel / any public URL.
PORTAL_PASSWORD=

# Optional call logging
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

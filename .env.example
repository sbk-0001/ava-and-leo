LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Persona: ava | leo
# Unset: leo on telephony (SIP / outbound), ava on web/console.
AGENT_PERSONA=

# Ava pipeline (AssemblyAI STT, Groq LLM, Cartesia TTS)
ASSEMBLYAI_API_KEY=
GROQ_API_KEY=
CARTESIA_API_KEY=

# Leo telephony path (OpenAI Realtime, model gpt-realtime)
OPENAI_API_KEY=
# Optional OpenAI Realtime voice (default: cedar)
LEO_REALTIME_VOICE=

# Outbound SIP (lk sip outbound list)
SIP_OUTBOUND_TRUNK_ID=
# Optional caller ID / from-number for outbound
SIP_OUTBOUND_NUMBER=
# Cold transfer destination (E.164 or sip: URI)
SIP_TRANSFER_TO=

# Inbound DID → branch. Comma-separated did:branch_id
# Example: +61242169911:shellharbour,+61242880737:dapto,+61242844486:woonona
SIP_DID_MAP=

# Practice software: disconnected (default, no invented diary) | mock
PRACTICE_SOFTWARE=

# Optional call logging
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
